# Copy to .env for local development. All values below are placeholders.

# Required
# Token permissions: Account Filter Lists Edit, Zone Read, Zone WAF Edit
CF_API_TOKEN=replace-with-your-api-token
CF_ACCOUNT_ID=replace-with-your-account-id
CF_LIST_ID=replace-with-your-list-id
RP_ID=visa.example.com
ORIGIN=https://visa.example.com

# Optional (defaults shown)
# CF_API_BASE_URL=https://api.cloudflare.com/client/v4
# DATA_FILE=./data/visa.json
# LISTEN=127.0.0.1:8787
# SETUP_TOKEN=
# MAX_LIFETIME=24h
# DURATIONS=1h,4h,12h
# Renew visas in use at 10, 5, 3 and 1 minutes before expiry (needs Zone Analytics Read on the token)
# AUTO_RENEW=false
# ACTIVE_WINDOW=15m
# RENEW_BY=2h
# RENEW_IGNORE_PATHS=
# IPv6 is issued for a whole network by default: 64, 56, 48, or 128 for one address
# IPV6_PREFIX=64
# MANUAL_ISSUE_ENABLED=false
# MANUAL_MIN_PREFIX_V4=24
# MANUAL_MIN_PREFIX_V6=48
# HEARTBEAT_URL=
# Optional: your ipinfo.io token, to show where issued addresses are (only after a passkey check)
# IPINFO_TOKEN=
# IPINFO_PLAN=lite
# BARK_SERVER=https://api.day.app
# BARK_DEVICE_KEYS=
# NOTIFY_EVENTS=issue,manual_issue,expire,revoke,renew,block,sync_fail
# NOTIFY_LANG=zh-Hant
# Time zone for times in notifications, e.g. Asia/Taipei (UTC when unset)
# TZ=
